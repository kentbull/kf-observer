# The core image contains the exact KERIpy source pinned in pyproject.toml.
ARG CORE_IMAGE=keripy-community:observations
FROM ${CORE_IMAGE}
WORKDIR /component
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN python -m pip install --no-deps --no-build-isolation .
COPY tests ./tests
CMD ["python", "-m", "pytest", "-q", "-o", "pythonpath=", "tests"]
